{
  "name": "hypnomentalism",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:usb": "adb reverse tcp:8081 tcp:8081 && expo start --localhost --port 8081",
    "android": "expo run:android",
    "android:preview": "expo run:android --variant release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:visuals": "node scripts/check-visual-lessons.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.20",
    "expo-status-bar": "~2.0.1",
    "expo-video": "~2.0.6",
    "react": "18.3.1",
    "react-native": "0.76.7"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
